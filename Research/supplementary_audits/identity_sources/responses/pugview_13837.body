                          "Type": "PubChem Internal Link",
                          "Extra": "CID-13836"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "ReferenceNumber": 40,
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "A plant growth regulator that is commonly used on ornamental plants."
