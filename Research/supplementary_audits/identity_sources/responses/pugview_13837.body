            "Information": [
              {
                "ReferenceNumber": 2,
                "Name": "Record Description",
                "Description": "Ontology Summary",
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "Chlormequat is a quaternary ammonium ion that is choline in which the hydroxy group has been replaced by a chlorine. Its salts (particularly the chloride salt, known as chlormequat chloride) are used as plant growth retardants. It has a role as a plant growth retardant.",
                      "Markup": [
                        {
                          "Start": 0,
                          "Length": 11,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/Chlormequat",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-13837"
                        },
                        {
                          "Start": 49,
                          "Length": 7,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/choline",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-305"
                        },
                        {
