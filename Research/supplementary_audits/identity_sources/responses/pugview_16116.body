                      "StringWithMarkup": [
                        {
                          "String": "/LABORATORY ANIMALS: Subchronic or Prechronic Exposure/ In 96 day feeding trials no nutritional or clinical sign of toxicity was observed in albino rats receiving 5000-7500 mg/kg diet."
                        }
