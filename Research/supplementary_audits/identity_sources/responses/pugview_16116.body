                    }
                  }
                ],
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "Unlike other substituted urea herbicides, siduron is not a potent inhibitor of photosynthesis; phytotoxic symptoms appear to be associated with root growth inhibition.",
