                              "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/siduron",
                              "Type": "PubChem Internal Link",
                              "Extra": "CID-16116"
                            }
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "ReferenceNumber": 21,
                    "Description": "PEER REVIEWED",
                    "Reference": [
                      "Humburg, N.E. (ed.). Herbicide Handbook of the Weed Science Society of America. 6th ed. Champaign, IL: Weed Science Society of America, 1989., p. 234"
                    ],
                    "ExtendedReference": [
                      {
                        "Citation": "Humburg, N.E. (ed.). Herbicide Handbook of the Weed Science Society of America. 6th ed. Champaign, IL: Weed Science Society of America, 1989., p. 234",
                        "Matched": {
