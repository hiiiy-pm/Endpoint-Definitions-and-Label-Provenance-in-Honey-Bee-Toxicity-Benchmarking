                    }
                  }
                ],
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "Most readily absorbed through root system; less so through foliage and stems. ... Experimental evidence indicates that Siduron is translocated in the xylem.",
                      "Markup": [
                        {
                          "Start": 119,
                          "Length": 7,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/Siduron",
