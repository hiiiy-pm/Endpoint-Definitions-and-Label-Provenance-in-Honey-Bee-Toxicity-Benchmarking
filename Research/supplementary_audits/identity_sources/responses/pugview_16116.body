                        }
                      }
                    ],
                    "Value": {
                      "StringWithMarkup": [
                        {
                          "String": "If serious dehydration and electrolyte depletion have occurred as a result of vomiting and diarrhea, monitor blood electrolytes and and fluid balance and administer intravenous infusions of glucose, normal saline ringer's solution, or ringer's lactate to restore extracellular fluid volume and electrolytes. Follow this with oral nutrients as soon as fluids can be retained. Fluids serve to support excretion of the toxicants. Supportive measures are ordinarily sufficient for successful management of excessive exposures to these herbicides. /Other Herbicides/",
                          "Markup": [
                            {
                              "Start": 190,
                              "Length": 7,
                              "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/glucose",
