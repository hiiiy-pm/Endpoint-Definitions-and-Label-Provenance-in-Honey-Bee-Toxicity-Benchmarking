      {
        "TOCHeading": "Pharmacology and Biochemistry",
        "Description": "Pharmacology and biochemistry information related to this compound, including the pharmacodynamics, pharmacokinetics, metabolism, mechanism of action, biological half-life, biochemical reactions, and many others.",
        "Section": [
          {
            "TOCHeading": "Absorption, Distribution and Excretion",
            "Information": [
              {
                "ReferenceNumber": 21,
                "Description": "PEER REVIEWED",
                "Reference": [
                  "Weed Science Society of America. Herbicide Handbook. 5th ed. Champaign, Illinois: Weed Science Society of America, 1983., p. 427"
                ],
                "ExtendedReference": [
                  {
                    "Citation": "Weed Science Society of America. Herbicide Handbook. 5th ed. Champaign, Illinois: Weed Science Society of America, 1983., p. 427",
                    "Matched": {
