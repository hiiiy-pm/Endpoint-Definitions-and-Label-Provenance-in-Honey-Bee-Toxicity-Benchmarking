                }
              }
            ]
          },
          {
            "TOCHeading": "Metabolism/Metabolites",
            "Description": "Metabolites are substances made or used when the body breaks down food, drugs or chemicals, or its own tissue (for example, fat or muscle tissue). This process is called metabolism and makes energy and the materials needed for growth, reproduction, and maintaining health. Metabolism also helps get rid of toxic substances.",
            "Information": [
              {
                "ReferenceNumber": 21,
                "Description": "PEER REVIEWED",
                "Reference": [
                  "California Environmental Protection Agency/Department of Pesticide Regulation; Toxicology Data Review Summary for Siduron (1982-49-6). Available from, as of May 13, 2009: https://www.cdpr.ca.gov/docs/risk/toxsums/toxsumlist.htm"
                ],
                "ExtendedReference": [
                  {
                    "Citation": "California Environmental Protection Agency/Department of Pesticide Regulation; Toxicology Data Review Summary for Siduron (1982-49-6). Available from, as of May 13, 2009: https://www.cdpr.ca.gov/docs/risk/toxsums/toxsumlist.htm",
                    "Matched": {
                      "PCLID": 900074178,
                      "Citation": "California Environmental Protection Agency/Department of Pesticide Regulation; Toxicology Data Review Summary for Siduron (1982-49-6). Available from, as of May 13, 2009: https://www.cdpr.ca.gov/docs/risk/toxsums/toxsumlist.htm"
                    }
                  }
                ],
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "Urine from a dog receiving 2500 ppm siduron in the diet was collected and analyzed for the parent compound and metabolites using a colorimetric method, and mass, IR, and NMR spectrometry, and a metabolic pathway was proposed; none of the parent compound was found, but three glucuronide conjugates of hydroxysubstituted siduron were isolated and identified, one substituted on the phenyl ring, one substituted on the cyclohexyl ring, and another substituted in both locations; it appears that siduron is first hydroxylated at either location, then both of these mono-hydroxylated compounds are hydroxylated again to form 1-(4-hydroxy-2-methylcyclo-hexyl)-3-p-hydroxyphenylurea; comparison of urine from the dog with that from a rat on a similar 2500 ppm diet, showed that the rat formed slightly less of the cyclohexyl-substituted compound than the dog; 800-1000 ppm of total siduron metabolites was bound in the urine of these two animals.",
                      "Markup": [
                        {
                          "Start": 36,
                          "Length": 7,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/siduron",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-16116"
                        },
                        {
                          "Start": 320,
                          "Length": 7,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/siduron",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-16116"
                        },
                        {
                          "Start": 493,
                          "Length": 7,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/siduron",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-16116"
                        },
                        {
                          "Start": 876,
                          "Length": 7,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/siduron",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-16116"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "ReferenceNumber": 21,
                "Description": "PEER REVIEWED",
                "Reference": [
                  "Weed Science Society of America. Herbicide Handbook. 5th ed. Champaign, Illinois: Weed Science Society of America, 1983., p. 427"
                ],
                "ExtendedReference": [
                  {
                    "Citation": "Weed Science Society of America. Herbicide Handbook. 5th ed. Champaign, Illinois: Weed Science Society of America, 1983., p. 427",
                    "Matched": {
                      "PCLID": 906283878,
                      "Citation": "Weed Science Society of America. Herbicide Handbook. 5th ed. Champaign, Illinois: Weed Science Society of America, 1983., p. 427"
                    }
                  }
                ],
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "In studies with (14)C-labeled siduron, no metabolites ... were detectable in barley plants after an 8 day absorption period.",
                      "Markup": [
                        {
                          "Start": 30,
                          "Length": 7,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/siduron",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-16116"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "ReferenceNumber": 21,
                "Description": "PEER REVIEWED",
                "Reference": [
                  "Kearney, P.C., and D. D. Kaufman (eds.) Herbicides: Chemistry, Degredation and Mode of Action. Volumes 1 and 2. 2nd ed. New York: Marcel Dekker, Inc., 1975., p. 246"
                ],
                "ExtendedReference": [
                  {
                    "Citation": "Kearney, P.C., and D. D. Kaufman (eds.) Herbicides: Chemistry, Degredation and Mode of Action. Volumes 1 and 2. 2nd ed. New York: Marcel Dekker, Inc., 1975., p. 246",
                    "Matched": {
                      "PCLID": 906291142,
                      "Citation": "Kearney, P.C., and D. D. Kaufman (eds.) Herbicides: Chemistry, Degredation and Mode of Action. Volumes 1 and 2. 2nd ed. New York: Marcel Dekker, Inc., 1975., p. 246"
                    }
                  }
                ],
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "... Both phenyl and cyclohexyl rings are subjected to hydroxylation in the dog. ... The pathways proposed ... show that siduron is either hydroxylated at para position of phenyl nucleus or at 4 position of 2-methylcyclohexyl moiety. Both metabolites are further hydroxylated to form 1-(4-hydroxy-2-methylcyclohexyl)-3-(p-hydroxyphenyl)urea.",
                      "Markup": [
                        {
                          "Start": 120,
                          "Length": 7,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/siduron",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-16116"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "ReferenceNumber": 21,
                "Description": "PEER REVIEWED",
                "Reference": [
                  "Kearney, P.C., and D. D. Kaufman (eds.) Herbicides: Chemistry, Degredation and Mode of Action. Volumes 1 and 2. 2nd ed. New York: Marcel Dekker, Inc., 1975., p. 246"
                ],
                "ExtendedReference": [
                  {
                    "Citation": "Kearney, P.C., and D. D. Kaufman (eds.) Herbicides: Chemistry, Degredation and Mode of Action. Volumes 1 and 2. 2nd ed. New York: Marcel Dekker, Inc., 1975., p. 246",
                    "Matched": {
                      "PCLID": 906291142,
                      "Citation": "Kearney, P.C., and D. D. Kaufman (eds.) Herbicides: Chemistry, Degredation and Mode of Action. Volumes 1 and 2. 2nd ed. New York: Marcel Dekker, Inc., 1975., p. 246"
                    }
                  }
                ],
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "When urine samples of both dogs and rats were subjected to hydrolysis and analyzed for aminophenol /as well as/ aniline, it was observed that hydroxylation of the phenyl moiety was more prominent in the rat than in dog. Apparently rats exhibit particular efficiency in hydroxylating the aromatic nucleus of phenylureas. In another study in which (14)C- carbonyl-labeled compound was applied ... microbial degradation was major route of siduron disappearance in soil. Metabolites separated on thin-layer plates had same characteristics as those identified in urine, and /it was/ ... concluded that ring hydroxylation was also operative in soil environment.",
                      "Markup": [
                        {
                          "Start": 112,
                          "Length": 7,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/aniline",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-6115"
                        },
