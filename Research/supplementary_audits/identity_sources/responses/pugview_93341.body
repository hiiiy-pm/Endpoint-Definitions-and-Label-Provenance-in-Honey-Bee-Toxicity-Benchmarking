            "Information": [
              {
                "ReferenceNumber": 2,
                "Name": "Record Description",
                "Description": "Ontology Summary",
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "Diclomezine is a pyridazinone that is pyridazin-3(2H)-one which is substituted at position 6 by a 3,5-dichloro-4-methylphenyl group. A fugicide, it is used to treat rice sheath blight caused by Rhizoctonia solani. It has a role as an antifungal agrochemical. It is a dichlorobenzene and a pyridazinone.",
                      "Markup": [
                        {
                          "Start": 51,
                          "Length": 1,
                          "Type": "Italics"
                        },
                        {
                          "Start": 194,
                          "Length": 18,
