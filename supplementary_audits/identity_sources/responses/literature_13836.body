<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="robots" content="noindex,nofollow,noarchive">
    <title>404: Not Found</title>
    <script type="text/javascript">
      window.ncbi_startTime = new Date ()
      
    </script>
    <script type="application/ld+json">
      {
          "@context": "https://schema.org",
          "@type": "Organization",
          "name": "PubChem",
          "url": "https://pubchem.ncbi.nlm.nih.gov",
          "logo": "https://pubchem.ncbi.nlm.nih.gov/pcfe/logo/PubChem_logo.png",
          "foundingDate": "2004"
      }
      
    </script>
    <link rel="apple-touch-icon" sizes="180x180" href="/pcfe/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/pcfe/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/pcfe/favicon/favicon-16x16.png">
    <link rel="icon" href="/pcfe/favicon/favicon.ico">
    <link rel="preconnect" href="https://www.ncbi.nlm.nih.gov">
    <link rel="preconnect" href="https://www.ncbi.nlm.nih.gov" crossorigin>
    <link rel="preconnect" href="https://www.googletagmanager.com">
    <link rel="preconnect" href="https://cdn.ncbi.nlm.nih.gov">
    <link rel="modulepreload" href="/pcfe/libs/react/react.production.19.2.7.min.js">
    <link rel="modulepreload" href="/pcfe/libs/react/react-dom.production.19.2.7.min.js">
    <link rel="modulepreload" href="/pcfe/libs/react/react-jsx-runtime.production.19.2.7.min.js">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="dark light">
    <meta name="application-name" content="PubChem">
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="white">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="black">
    <meta name="author" content="PubChem">
    <meta name="ncbi_db" content="pubchem">
    <meta name="ncbi_pinger_ga_track" content="true">
    <meta name="ncbi_pinger_track_stat" content="true">
    <meta name="ncbi_pinger_section_duration" content="false">
    <meta name="ncbi_app" content="pc-404">
    <meta name="ncbi_pdid" content="error-404">
    <meta name="pubchem_tracking_category" content="error-404">
    <meta name="pubchem_not_found" content="sdq/sdqagent.cgi">
    <meta name="description" content="Error 404. We could not find the page you were looking for...">
    <script>
      const root = document.documentElement
      const storageAvailable = (() => {
        try {
          window.localStorage.test = 0
          window.localStorage.removeItem('test')
          return true
        } catch (e) {
          return false
        }
      })()
      const traceEnabled = /(?:^|[?#&])themeTrace=1(?:$|[&#])/i.test(String(location.search) + String(location.hash))
      window.__PC_THEME_TRACE = traceEnabled
      const trace = (label, payload) => {
        if (!traceEnabled || typeof console === 'undefined') return
        const now = typeof performance !== 'undefined' && typeof performance.now === 'function' ? Math.round(performance.now()) : null
        console.log('[theme-init]', label, { t: now, ...payload })
      }
      function setMode(reason = 'init') {
        const hasStoredMode = 'mode' in localStorage
        const storedMode = hasStoredMode ? localStorage.mode : '(unset)'
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        const useDark = storedMode === 'dark' || ((!hasStoredMode || storedMode === 'system') && systemDark)
        root.classList.toggle('dark', useDark)
        trace('setMode', { reason, storedMode, hasStoredMode, systemDark, useDark, className: root.className })
      }
      const forceLight = String(location.hash).match(/mode=light/i)
      if (!forceLight && storageAvailable) {
        window.addEventListener('storage', () => {
          trace('storage-event', {})
          setMode('storage')
        })
        trace('bootstrap', { storageAvailable, forceLight: false })
        setMode('init')
      } else {
        trace('bootstrap-skipped', { storageAvailable, forceLight: Boolean(forceLight) })
      }
    </script>
    <link rel="stylesheet" href="/pcfe/libs/styles/pubchem.min.css" type="text/css">
  </head>
  <body>
    <noscript>
      <div class="main-width pt-8 pb-8">
        <div><img src="/pcfe/logo/PubChem_logo.svg" alt="PubChem logo" width="300" height="88"></div>
        <div class="bg-spill pt-4">
          <h1 class="text-red-500 font-bold text-2xl mb-2">JavaScript is required...</h1>
          <p>Please enable Javascript in order to use PubChem website.</p>
        </div>
      </div>
    </noscript>
    <div id="root"></div>
    <div id="root-modal"></div>
    <script type="text/javascript" async src="https://www.ncbi.nlm.nih.gov/core/pinger/pinger.js"></script>
