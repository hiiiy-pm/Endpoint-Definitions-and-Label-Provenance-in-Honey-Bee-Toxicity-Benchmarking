                    }
                  }
                ],
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "Chlormequat chloride has been reported in the literature to act at the nicotinic receptor site of the neuromuscular junction. The test material may act as a depolarizing agent at this site, leading to muscular excitation followed by muscle weakness. Acute toxicity may lead to respiratory arrest. Acute toxicity of chlormequat chloride has also been reported to differ by species, which is likely due to sensitivity to depolarizing neuromuscular blockers.",
                      "Markup": [
                        {
                          "Start": 0,
                          "Length": 20,
