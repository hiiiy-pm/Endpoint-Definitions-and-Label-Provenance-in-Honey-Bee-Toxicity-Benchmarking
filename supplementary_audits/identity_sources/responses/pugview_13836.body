                    "ExtendedReference": [
                      {
                        "Citation": "Currance, P.L. Clements, B., Bronstein, A.C. (Eds).; Emergency Care For Hazardous Materials Exposure. 3Rd edition, Elsevier Mosby, St. Louis, MO 2005, p. 160",
                        "Matched": {
                          "PCLID": 900124670,
                          "Citation": "Currance, P.L. Clements, B., Bronstein, A.C. (Eds).; Emergency Care For Hazardous Materials Exposure. 3Rd edition, Elsevier Mosby, St. Louis, MO 2005, p. 160"
                        }
                      }
                    ],
                    "Value": {
                      "StringWithMarkup": [
                        {
                          "String": "Immediate first aid: Ensure that adequate decontamination has been carried out. If patient is not breathing, start artificial respiration, preferably with a demand valve resuscitator, bag-valve-mask device, or pocket mask, as trained. Perform CPR if necessary. Immediately flush contaminated eyes with gently flowing water. Do not induce vomiting. If vomiting occurs, lean patient forward or place on the left side (head-down position, if possible) to maintain an open airway and prevent aspiration. Keep patient quiet and maintain normal body temperature. Obtain medical attention. /Poisons A and B/",
                          "Markup": [
                            {
                              "Start": 317,
                              "Length": 5,
                              "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/water",
                              "Type": "PubChem Internal Link",
                              "Extra": "CID-962"
                            }
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "ReferenceNumber": 21,
                    "Description": "PEER REVIEWED",
                    "Reference": [
                      "Currance, P.L. Clements, B., Bronstein, A.C. (Eds).; Emergency Care For Hazardous Materials Exposure. 3Rd edition, Elsevier Mosby, St. Louis, MO 2005, p. 160"
                    ],
                    "ExtendedReference": [
                      {
                        "Citation": "Currance, P.L. Clements, B., Bronstein, A.C. (Eds).; Emergency Care For Hazardous Materials Exposure. 3Rd edition, Elsevier Mosby, St. Louis, MO 2005, p. 160",
                        "Matched": {
