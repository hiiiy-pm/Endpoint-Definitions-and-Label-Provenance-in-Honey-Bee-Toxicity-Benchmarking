            "Section": [
              {
                "TOCHeading": "First Aid",
                "Description": "First aid measures for exposure to this chemical through various routes (for example, ingestion, inhalation, skin contact, and eye contact).",
                "Information": [
                  {
                    "ReferenceNumber": 2,
                    "Reference": [
                      "U.S. Environmental Protection Agency. 1998. Extremely Hazardous Substances (EHS) Chemical Profiles and Emergency First Aid Guides. Washington, D.C.: U.S. Government Printing Office."
