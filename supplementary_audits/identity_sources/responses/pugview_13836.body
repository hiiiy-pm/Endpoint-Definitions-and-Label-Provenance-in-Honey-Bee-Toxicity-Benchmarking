              {
                "ReferenceNumber": 2,
                "Description": "Physical Description",
                "Reference": [
                  "U.S. Environmental Protection Agency. 1998. Extremely Hazardous Substances (EHS) Chemical Profiles and Emergency First Aid Guides. Washington, D.C.: U.S. Government Printing Office."
                ],
                "ExtendedReference": [
                  {
                    "Citation": "U.S. Environmental Protection Agency. 1998. Extremely Hazardous Substances (EHS) Chemical Profiles and Emergency First Aid Guides. Washington, D.C.: U.S. Government Printing Office.",
                    "Matched": {
                      "PCLID": 906297336,
                      "Citation": "U.S. Environmental Protection Agency. 1998. Extremely Hazardous Substances (EHS) Chemical Profiles and Emergency First Aid Guides. Washington, D.C.: U.S. Government Printing Office."
                    }
                  }
                ],
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "Chlormequat chloride appears as white crystals with a fishlike odor. Used as a plant growth regulator. Said to be effective for cereal grains, tomatoes, and peppers. (EPA, 1998)",
                      "Markup": [
                        {
                          "Start": 0,
                          "Length": 20,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/Chlormequat%20chloride",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-13836"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "ReferenceNumber": 4,
                "Name": "Record Description",
                "Description": "Ontology Summary",
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "Chlormequat chloride is an organic chloride salt comprising equal numbers of chlormequat and chloride ions. A gibberellin biosynthesis inhibitor, it is used as a plant growth retardant to produce plants with sturdier, thicker stalks, facilitating the havesting of ornamental flowers and cereal crops. It has a role as an agrochemical and a plant growth retardant. It is a quaternary ammonium salt and an organic chloride salt. It contains a chlormequat.",
                      "Markup": [
                        {
                          "Start": 0,
                          "Length": 20,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/Chlormequat%20chloride",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-13836"
                        },
                        {
                          "Start": 77,
                          "Length": 11,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/chlormequat",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-13837"
                        },
                        {
                          "Start": 93,
                          "Length": 8,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/chloride",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-312"
                        },
                        {
                          "Start": 441,
                          "Length": 11,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/chlormequat",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-13837"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
