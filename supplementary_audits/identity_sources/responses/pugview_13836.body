                        },
                        {
                          "Start": 291,
                          "Length": 11,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/acetic%20acid",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-176"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "ReferenceNumber": 21,
                "Description": "PEER REVIEWED",
                "Reference": [
                  "Allender WJ; Pestic Sci 35 (3): 265-9 (1992)"
                ],
                "ExtendedReference": [
                  {
                    "Citation": "Allender WJ; Pestic Sci 35 (3): 265-9 (1992)",
                    "Matched": {
                      "PCLID": 900090825,
                      "Citation": "Allender WJ; Pestic Sci 35 (3): 265-9 (1992)"
                    }
                  }
                ],
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "A simple and sensitive method to detn chlormequat (chlorocholine chloride) residues in plant tissue has been devised. The technique is based on an in vitro multi-step reaction where chlormequat is initially N-demethylated with potassium pentafluorothiophenolate followed by a further reaction with excess reagent to produce a pentafluorothiophenyl deriv. ECD and MS were used for quant detn and identification. The method was applied to the analysis of cotton seed harvested from cotton plants treated with various concn of chlormequat.",
                      "Markup": [
                        {
                          "Start": 38,
                          "Length": 11,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/chlormequat",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-13837"
                        },
                        {
                          "Start": 51,
                          "Length": 22,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/chlorocholine%20chloride",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-13836"
                        },
                        {
                          "Start": 182,
                          "Length": 11,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/chlormequat",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-13837"
                        },
                        {
                          "Start": 524,
                          "Length": 11,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/chlormequat",
                          "Type": "PubChem Internal Link",
