                        }
                      ]
                    }
                  ]
                }
              },
              {
                "ReferenceNumber": 21,
                "Description": "PEER REVIEWED",
                "Reference": [
                  "Menzie, C.M. Metabolism of Pesticides-Update III. Special Scientific Report- Wildlife No. 232. Washington, DC: U.S.Department of the Interior, Fish and Wildlife Service, 1980., p. 115"
                ],
                "ExtendedReference": [
                  {
                    "Citation": "Menzie, C.M. Metabolism of Pesticides-Update III. Special Scientific Report- Wildlife No. 232. Washington, DC: U.S.Department of the Interior, Fish and Wildlife Service, 1980., p. 115",
                    "Matched": {
                      "PCLID": 900159305,
                      "Citation": "Menzie, C.M. Metabolism of Pesticides-Update III. Special Scientific Report- Wildlife No. 232. Washington, DC: U.S.Department of the Interior, Fish and Wildlife Service, 1980., p. 115"
                    }
                  }
                ],
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "When (14)C-labeled CCC was applied to kohlrabi, cauliflower, or tomatoes, degradation of CCC was very small. The first product was probably choline which entered the plant pool. Small amounts of labeled methyl groups from choline were found as S-methyl methionine. CCC was not degraded when applied to sugarcane. In alfalfa, CCC was slowly metabolized and was primarily incorporated into choline of phosphatidylcholine.",
                      "Markup": [
                        {
                          "Start": 140,
                          "Length": 7,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/choline",
                          "Type": "PubChem Internal Link",
