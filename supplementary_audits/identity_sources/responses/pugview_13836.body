                    "Reference": [
                      "USEPA/Office of Pesticide Programs; Environmental Fate and Ecological Risk Assessment for the Reregistration of Chlormequat Chloride p.20 EPA-HQ-OPP-2007-0968-0002 (2007). Available from, as of October 27, 2008: https://www.epa.gov/pesticides/reregistration/status.htm"
                    ],
                    "ExtendedReference": [
                      {
                        "Citation": "USEPA/Office of Pesticide Programs; Environmental Fate and Ecological Risk Assessment for the Reregistration of Chlormequat Chloride p.20 EPA-HQ-OPP-2007-0968-0002 (2007). Available from, as of October 27, 2008: https://www.epa.gov/pesticides/reregistration/status.htm",
                        "Matched": {
