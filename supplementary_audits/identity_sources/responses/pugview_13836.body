                      }
                    ],
                    "Value": {
                      "StringWithMarkup": [
                        {
                          "String": "An estimated BCF of 3.2 was calculated for chlormequat chloride(SRC), using a log Kow of -3.80(1) and a regression-derived equation(2). According to a classification scheme(3), this BCF suggests the potential for bioconcentration in aquatic organisms is low(SRC).",
                          "Markup": [
