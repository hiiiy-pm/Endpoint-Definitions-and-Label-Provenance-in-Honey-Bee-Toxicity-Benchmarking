                "Description": "PEER REVIEWED",
                "Reference": [
                  "Menzie, C.M. Metabolism of Pesticides-Update III. Special Scientific Report- Wildlife No. 232. Washington, DC: U.S.Department of the Interior, Fish and Wildlife Service, 1980., p. 115"
                ],
                "ExtendedReference": [
                  {
                    "Citation": "Menzie, C.M. Metabolism of Pesticides-Update III. Special Scientific Report- Wildlife No. 232. Washington, DC: U.S.Department of the Interior, Fish and Wildlife Service, 1980., p. 115",
                    "Matched": {
                      "PCLID": 900159305,
                      "Citation": "Menzie, C.M. Metabolism of Pesticides-Update III. Special Scientific Report- Wildlife No. 232. Washington, DC: U.S.Department of the Interior, Fish and Wildlife Service, 1980., p. 115"
                    }
                  }
                ],
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "Almond seedlings were treated with labeled CCC. Translocation to leaves and to the roots was observed. (14)CO2 was formed within 2 h after application. Radioactivity was observed in 17 known amino acids, an unidentified ninhydrin positive compound, malic acid, citric acid, choline and 2-chloroethylamine.",
                      "Markup": [
