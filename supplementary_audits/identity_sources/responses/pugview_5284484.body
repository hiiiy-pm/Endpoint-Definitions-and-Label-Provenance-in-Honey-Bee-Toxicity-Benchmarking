              },
              {
                "ReferenceNumber": 24,
                "Description": "PEER REVIEWED",
                "Reference": [
                  "Hayes, Wayland J., Jr. Pesticides Studied in Man. Baltimore/London: Williams and Wilkins, 1982., p. 609"
                ],
                "ExtendedReference": [
                  {
                    "Citation": "Hayes, Wayland J., Jr. Pesticides Studied in Man. Baltimore/London: Williams and Wilkins, 1982., p. 609",
