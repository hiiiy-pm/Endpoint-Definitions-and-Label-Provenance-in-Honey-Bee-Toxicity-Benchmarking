                  {
                    "ReferenceNumber": 24,
                    "Description": "PEER REVIEWED",
                    "Reference": [
                      "Ghate HV; Geobios 12 (5): 182-5 (1985)"
                    ],
                    "ExtendedReference": [
                      {
                        "Citation": "Ghate HV; Geobios 12 (5): 182-5 (1985)",
                        "Matched": {
                          "PCLID": 906272963,
                          "Citation": "Ghate HV; Geobios 12 (5): 182-5 (1985)"
                        }
