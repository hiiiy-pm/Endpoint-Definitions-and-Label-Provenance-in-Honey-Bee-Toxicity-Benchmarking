                  }
                ],
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "... Only 11 to 17% of an oral dose of zineb is absorbed from the gastrointestinal tract of the rat. Some additional material may be absorbed following breakdown in the intestine. At different dietary levels 68.5 to 74.9% of the ingested material was recovered unchanged in the feces.",
                      "Markup": [
                        {
                          "Start": 38,
                          "Length": 5,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/zineb",
