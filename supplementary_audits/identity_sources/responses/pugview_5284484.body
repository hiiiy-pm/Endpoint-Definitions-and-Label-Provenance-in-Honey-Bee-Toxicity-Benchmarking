                    ],
                    "Value": {
                      "StringWithMarkup": [
                        {
                          "String": "The International Air Transport Association (IATA) Dangerous Goods Regulations are published by the IATA Dangerous Goods Board pursuant to IATA Resolutions 618 and 619 and constitute a manual of industry carrier regulations to be followed by all IATA Member airlines when transporting hazardous materials."
                        }
                      ]
