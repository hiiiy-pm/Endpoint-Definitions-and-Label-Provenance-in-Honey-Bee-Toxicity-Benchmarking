              },
              {
                "ReferenceNumber": 25,
                "Name": "",
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "Use water spray, foam, powder, carbon dioxide. In case of fire: keep drums, etc., cool by spraying with water.",
