            "Information": [
              {
                "ReferenceNumber": 2,
                "Name": "Record Description",
                "Description": "Ontology Summary",
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "Metiram can cause cancer and developmental toxicity according to The Environmental Protection Agency (EPA)."
                    }
                  ]
                }
              },
              {
                "ReferenceNumber": 3,
                "Description": "Physical Description",
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "Zineb appears as an off-white powder. Used as a fungicide.",
                      "Markup": [
                        {
                          "Start": 0,
                          "Length": 5,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/Zineb",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-5284484"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "ReferenceNumber": 5,
                "Name": "Record Description",
                "Description": "Ontology Summary",
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "Zineb is a polymeric complex of zinc with the ethylene bis(dithiocarbamate) anionic ligand. Formerly used as an agricultural fungicide for the control of downy mildews and rusts, its use is no longer permitted in the US or the EU. It has a role as an antifungal agrochemical. It is a macromolecule, a zinc coordination entity and a dithiocarbamate salt. It contains an ethylenebis(dithiocarbamate).",
                      "Markup": [
                        {
                          "Start": 0,
                          "Length": 5,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/Zineb",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-5284484"
                        },
                        {
                          "Start": 32,
                          "Length": 4,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/element/Zinc",
                          "Type": "PubChem Internal Link",
                          "Extra": "Element-Zinc"
                        },
                        {
                          "Start": 301,
                          "Length": 4,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/element/Zinc",
                          "Type": "PubChem Internal Link",
                          "Extra": "Element-Zinc"
                        },
                        {
                          "Start": 332,
                          "Length": 15,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/dithiocarbamate",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-3037131"
                        },
                        {
                          "Start": 369,
                          "Length": 28,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/ethylenebis%28dithiocarbamate%29",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-4228010"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "ReferenceNumber": 37,
                "ExtendedReference": [
                  {
                    "Citation": "L48: Wikipedia. Zinc. Last Updated 24 March 2009. http://en.wikipedia.org/wiki/Zinc",
                    "Matched": {
                      "PCLID": 900177034,
                      "Citation": "L48: Wikipedia. Zinc. Last Updated 24 March 2009. http://en.wikipedia.org/wiki/Zinc"
                    }
                  },
                  {
                    "Citation": "L49: ATSDR - Agency for Toxic Substances and Disease Registry (2005). Toxicological profile for zinc. U.S. Public Health Service in collaboration with U.S. Environmental Protection Agency (EPA). http://www.atsdr.cdc.gov/toxprofiles/tp60.html",
                    "Matched": {
                      "PCLID": 900178101,
                      "Citation": "L49: ATSDR - Agency for Toxic Substances and Disease Registry (2005). Toxicological profile for zinc. U.S. Public Health Service in collaboration with U.S. Environmental Protection Agency (EPA). http://www.atsdr.cdc.gov/toxprofiles/tp60.html"
                    }
                  },
                  {
                    "Citation": "L540: Wikipedia. Zineb. Last Updated 15 May 2009. http://en.wikipedia.org/wiki/Zineb",
                    "Matched": {
                      "PCLID": 900176951,
                      "Citation": "L540: Wikipedia. Zineb. Last Updated 15 May 2009. http://en.wikipedia.org/wiki/Zineb"
                    }
                  }
                ],
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "Zineb is a polymeric complex of zinc with the ethylene bis(dithiocarbamate) anionic ligand. It is used as a fungicide to control downy mildews, rusts and redfire disease. Zinc is a metallic element with the atomic number 30. It is found in nature most often as the mineral sphalerite. Though excess zinc in harmful, in smaller amounts it is an essential element for life, as it is a cofactor for over 300 enzymes and is found in just as many transcription factors. (L48, L49, L540)",
                      "Markup": [
                        {
                          "Start": 0,
                          "Length": 5,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/compound/Zineb",
                          "Type": "PubChem Internal Link",
                          "Extra": "CID-5284484"
                        },
                        {
                          "Start": 32,
                          "Length": 4,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/element/Zinc",
                          "Type": "PubChem Internal Link",
                          "Extra": "Element-Zinc"
                        },
                        {
                          "Start": 171,
                          "Length": 4,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/element/Zinc",
                          "Type": "PubChem Internal Link",
                          "Extra": "Element-Zinc"
                        },
                        {
                          "Start": 299,
                          "Length": 4,
                          "URL": "https://pubchem.ncbi.nlm.nih.gov/element/Zinc",
                          "Type": "PubChem Internal Link",
                          "Extra": "Element-Zinc"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "ReferenceNumber": 41,
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "An agricultural fungicide of the dithiocarbamate class. It has relatively low toxicity and there is little evidence of human injury from exposure."
                    }
                  ]
                }
              }
            ]
