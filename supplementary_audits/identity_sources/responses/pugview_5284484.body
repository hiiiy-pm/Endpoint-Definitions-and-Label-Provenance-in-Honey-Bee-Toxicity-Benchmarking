                    }
                  }
                ],
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "... Approx 70-75% of ingested zineb passed through the gastrointestinal tract of rats and appeared in the feces within 24-72 hr.",
                      "Markup": [
                        {
                          "Start": 30,
