              {
                "ReferenceNumber": 24,
                "Description": "PEER REVIEWED",
                "Reference": [
                  "PMID:3114968",
                  "Searle AJ et al; Xenobiotica 17 (6): 733-40 (1987)."
                ],
                "ExtendedReference": [
                  {
                    "Citation": "PMID:3114968",
                    "Matched": {
