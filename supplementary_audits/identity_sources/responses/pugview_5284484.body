                ]
              },
              {
                "TOCHeading": "Personal Protective Equipment (PPE)",
                "Description": "Personal protective equipment (PPE) to use when handling this chemical.",
                "Information": [
                  {
                    "ReferenceNumber": 3,
                    "Reference": [
                      "National Toxicology Program, Institute of Environmental Health Sciences, National Institutes of Health (NTP). 1992. National Toxicology Program Chemical Repository Database. Research Triangle Park, North Carolina."
                    ],
                    "ExtendedReference": [
                      {
                        "Citation": "National Toxicology Program, Institute of Environmental Health Sciences, National Institutes of Health (NTP). 1992. National Toxicology Program Chemical Repository Database. Research Triangle Park, North Carolina.",
                        "Matched": {
                          "PCLID": 900163266,
                          "Citation": "National Toxicology Program, Institute of Environmental Health Sciences, National Institutes of Health (NTP). 1992. National Toxicology Program Chemical Repository Database. Research Triangle Park, North Carolina."
                        }
                      }
                    ],
                    "Value": {
                      "StringWithMarkup": [
                        {
                          "String": "RECOMMENDED RESPIRATOR: Where the neat test chemical is weighed and diluted, wear a NIOSH-approved half face respirator equipped with an organic vapor/acid gas cartridge (specific for organic vapors, HCl, acid gas and SO2) with a dust/mist filter. (NTP, 1992)"
                        }
                      ]
                    }
                  },
                  {
                    "ReferenceNumber": 24,
                    "Description": "PEER REVIEWED",
                    "Reference": [
                      "International Labour Office. Encyclopedia of Occupational Health and Safety. Vols. I&II. Geneva, Switzerland: International Labour Office, 1983., p. 390"
                    ],
                    "ExtendedReference": [
                      {
                        "Citation": "International Labour Office. Encyclopedia of Occupational Health and Safety. Vols. I&II. Geneva, Switzerland: International Labour Office, 1983., p. 390",
                        "Matched": {
                          "PCLID": 900108552,
                          "Citation": "International Labour Office. Encyclopedia of Occupational Health and Safety. Vols. I&II. Geneva, Switzerland: International Labour Office, 1983., p. 390"
                        }
                      }
                    ],
                    "Value": {
                      "StringWithMarkup": [
                        {
                          "String": "Personal protective equipment should be issued to workers engaged in prodn of carbamates or in their agricultural use, in particular eye protections and respirators to those who spray crops. /Carbamates and thiocarbamates/"
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "TOCHeading": "Fire Prevention",
                "Description": "Precautionary measures to prevent fires from this chemical.",
                "Information": [
                  {
                    "ReferenceNumber": 25,
                    "Name": "",
                    "Value": {
                      "StringWithMarkup": [
                        {
                          "String": "NO open flames. Closed system, dust explosion-proof electrical equipment and lighting. Prevent deposition of dust."
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "TOCHeading": "Exposure Prevention",
                "Description": "Prevention measures to avoid exposure to this chemical through various routes (for example, ingestion, inhalation, skin contact, and eye contact).",
                "Information": [
                  {
