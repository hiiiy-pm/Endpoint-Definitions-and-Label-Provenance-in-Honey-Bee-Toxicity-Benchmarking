                  },
                  {
                    "ReferenceNumber": 24,
                    "Description": "PEER REVIEWED",
                    "Reference": [
                      "IMDG; International Maritime Dangerous Goods Code; International Maritime Organization p.3270, 6219, 6220, and 6221 (1998)"
                    ],
                    "ExtendedReference": [
                      {
                        "Citation": "IMDG; International Maritime Dangerous Goods Code; International Maritime Organization p.3270, 6219, 6220, and 6221 (1998)",
                        "Matched": {
