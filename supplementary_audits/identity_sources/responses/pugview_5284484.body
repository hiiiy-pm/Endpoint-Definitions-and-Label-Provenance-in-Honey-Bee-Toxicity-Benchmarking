                        }
                      }
                    ],
                    "Value": {
                      "StringWithMarkup": [
                        {
                          "String": "Pesticide chemicals that cause related pharmacological effects will be regarded as having an additive deleterious action. Where residues from two or more chemicals in the same class are present in or on a raw agricultural commodity the tolerance for the total of such residues shall be the same as that having the lowest numerical tolerance in this class. Zineb is a member of the class of dithiocarbamates.",
                          "Markup": [
