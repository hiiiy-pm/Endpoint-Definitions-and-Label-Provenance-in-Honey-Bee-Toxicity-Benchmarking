                "ReferenceNumber": 25,
                "Name": "Eye First Aid",
                "Value": {
                  "StringWithMarkup": [
                    {
                      "String": "First rinse with plenty of water for several minutes (remove contact lenses if easily possible), then refer for medical attention.",
